{
  "manifest_version": 2,
  "id": "com.maibot.minecraft-player",
  "version": "2.0.5",
  "name": "Minecraft 陪玩",
  "description": "让麦麦进入 Minecraft Java 版服务器，像真人玩家一样走动、挖矿、放置、战斗和聊天。",
  "author": {
    "name": "MaiBot Minecraft Plugin",
    "url": "https://github.com/Mai-with-u/MaiBot"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/your-name/maibot-minecraft",
    "homepage": "https://github.com/Mai-with-u/MaiBot",
    "documentation": "https://github.com/your-name/maibot-minecraft/blob/main/README.md"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.23.99"
  },
  "dependencies": [],
  "changelog": "CHANGELOG.md",
  "plugin_type": "game",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "pickaxe",
      "fallback": "gamepad-2",
      "background": "#3b8526"
    }
  },
  "capabilities": ["send.text", "llm.generate"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
